# Local Oracle test-box inventory, sourced by the Scripts/*.sh helpers.
#
#   cp boxes.env.template boxes.env    and fill in your own values.
#
# boxes.env is GITIGNORED and never ships. Everything here is a DEFAULT: an
# environment variable set by the caller always wins, which is how the multi-box
# runs select a server without editing anything.
#
# Nothing here is required. With no boxes.env the scripts still run; they simply
# have no default server, so MCPDBWIZARD_TEST_HOST (etc.) must be set explicitly and
# the provisioning check reports "cannot connect -- SKIPPED" rather than failing.

# Default server for testrun_current.sh, check_provisioning.sh and the small
# regression legs under Scripts/*/run.sh.
# A leading '/' on the SID means SERVICE_NAME rather than SID.
export MCPDBWIZARD_TEST_HOST=${MCPDBWIZARD_TEST_HOST:-${ORINDA_TEST_HOST:-your-host}}
export MCPDBWIZARD_TEST_PORT=${MCPDBWIZARD_TEST_PORT:-${ORINDA_TEST_PORT:-1521}}
export MCPDBWIZARD_TEST_SID=${MCPDBWIZARD_TEST_SID:-${ORINDA_TEST_SID:-/YOURPDB}}

# SYSTEM's password on the provisioning targets. The schema DDL under sql/ embeds
# `connect system/<password>@&1` lines, so testdata*.sh must pass it through.
export MCPDBWIZARD_SYSTEM_PASSWORD=${ORINDA_SYSTEM_PASSWORD:-change-me}

# The generator's access code (first argument to ProcBuilder). Any string of 19+
# characters that is not a path and not the literal "build".
export MCPDBWIZARD_ACCESS_CODE=${ORINDA_ACCESS_CODE:-change-me-to-19-or-more-chars}

# The schema the propfiles introspect, and its password. testrun_current.sh refuses to run
# without these -- there is deliberately no built-in default, because the schema name is not
# something this repository publishes.
export ORINDA_TEST_USER=${ORINDA_TEST_USER:-YOUR_SCHEMA}
export ORINDA_TEST_PASSWORD=${ORINDA_TEST_PASSWORD:-your_password}

# The three Oracle DIRECTORY objects holding the BFILE test files, in order: the two your main
# fixture schema owns, then the byte-test schema's. Leave unset if your box does not use the
# UTL_FILE fixture path -- the BFILE half of the preflight then skips rather than failing.
export MCPDBWIZARD_BFILE_DIRS="YOUR_SCHEMA_TESTDIR1,YOUR_SCHEMA_TESTDIR2,BYTETEST_TESTDIR1"
